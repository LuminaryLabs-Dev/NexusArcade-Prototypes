oup.add(this.body);for(const s of [-1,1]){const horn=new THREE.Mesh(new THREE.ConeGeometry(.2,.8,8),red);horn.rotation.z=s*.65;horn.position.set(s*.56,1.65,0);this.group.add(horn);const leg=box(.24,.7,.3,metal);leg.position.set(s*.26,.36,0);this.group.add(leg);}}
        else if(this.type==='turret'){this.hp=72;this.radius=.95;const base=cyl(.82,.38,metal);base.position.y=.19;this.group.add(base);this.body=cyl(.62,1.15,metal);this.body.position.y=.78;this.group.add(this.body);const ring=new THREE.Mesh(new THREE.TorusGeometry(.68,.08,8,24),energyMaterial(C.red,.72));ring.rotation.x=Math.PI/2;ring.position.y=.85;this.group.add(ring);this.spin.push(ring);const gun=box(.28,.28,1.5,red);gun.position.set(0,1.28,.42);this.group.add(gun);}
        else{this.hp=145;this.radius=1.32;this.body=box(1.75,2.35,1.2,metal);this.body.position.y=1.25;this.group.add(this.body);const chest=box(1.05,.9,.28,orange);chest.position.set(0,1.55,.72);this.group.add(chest);for(const s of [-1,1]){const shoulder=new THREE.Mesh(new THREE.DodecahedronGeometry(.62,0),metal);shoulder.position.set(s*1.05,1.85,0);this.group.add(shoulder);const fist=box(.55,.75,.65,orange);fist.position.set(s*1.05,.78,.1);this.group.add(fist);}}
        this.maxHp=this.hp;this.weak=new THREE.Mesh(new THREE.SphereGeometry(this.type==='brute'?.36:.23,16,12),energyMaterial(C.orange,.95));this.weak.position.set(0,this.type==='drone'?0:this.type==='brute'?1.55:1.08,.67);this.group.add(this.weak);this.telegraph=new THREE.Mesh(new THREE.RingGeometry(.7,1.05,32),new THREE.MeshBasicMaterial({color:C.orange,transparent:true,opacity:.6,side:THREE.DoubleSide,blending:THREE.AdditiveBlending,depthWrite:false}));this.telegraph.rotation.x=-Math.PI/2;this.telegraph.position.y=.04;this.telegraph.visible=false;this.group.add(this.telegraph);}
      update(dt,speed){if(this.dead)return;this.t+=dt;this.attack-=dt;this.group.position.z+=speed*dt*(this.type==='turret'?.7:1);for(const p of this.spin)p.rotation.z+=dt*5;this.weak.scale.setScalar(.86+Math.sin(this.t*7)*.16);this.telegraph.visible=this.attack<.62;this.telegraph.scale.setScalar(1+Math.max(0,.62-this.attack)*2.5);if(this.type==='drone'){this.group.position.x+=this.velX*dt*2.4;this.group.position.y+=Math.sin(this.t*3)*dt*.5;this.body.rotation.y+=dt*2.2;if(Math.abs(this.group.position.x)>8)this.velX*=-1;}
        if(this.type==='rusher'&&this.attack<.55){this.body.material.emissive.setHex(C.orange);this.body.material.emissiveIntensity=2.5;if(this.attack<0)this.group.position.z+=15*dt;}
        if(this.type==='turret'&&this.attack<.6)this.weak.scale.setScalar(1.5+Math.sin(this.t*20)*.3);
        if(this.attack<=-0.2){this.fire();this.attack=this.type==='rusher'?rand(2.5,3.5):rand(1.8,3.1);this.weak.scale.setScalar(1);}
        if(this.group.position.z>6){player.damage(this.type==='brute'?20:this.type==='rusher'?15:9);this.destroy(false);}}
      fire(){if(this.type==='rusher')return;const origin=this.group.position.clone().add(new THREE.Vector3(0,this.type==='drone'?0:1,0)),target=player.group.position.clone().add(new THREE.Vector3(0,1,0)),d=target.clone().sub(origin).normalize();fx.arc(origin,target,C.red);game.spawnEnemyBullet(origin,d,this.type==='brute'?13:9);}
      takeDamage(n,environmental=false,crit=false){if(this.dead)return;this.hp-=n;this.body.material.emissiveIntensity=2.7;setTimeout(()=>{if(!this.dead)this.body.material.emissiveIntensity=.4},45);fx.burst(this.weak.getWorldPosition(new THREE.Vector3()),crit?C.orange:C.cyan,crit?8:3,5);audio.hit(crit);if(this.hp<=0){const base={drone:220,rusher:260,turret:300,brute:650}[this.type];game.addScore(base+(crit?100:0));game.onKill();this.destroy(true,environmental);}}
      destroy(explode){if(this.dead)return;this.dead=true;if(explode){fx.burst(this.group.position.clone().add(new THREE.Vector3(0,1,0)),this.type==='brute'?C.orange:C.red,this.type==='brute'?22:12,8);audio.boom();}scene.remove(this.group);const i=game.enemies.indexOf(this);if(i>=0)game.enemies.splice(i,1);}
    }

    class ApexWarden{
      constructor(){this.group=new THREE.Group();this.group.position.set(0,3,-24);scene.add(this.group);this.hp=620;this.maxHp=620;this.t=0;this.attack=2;this.phase=1;this.dead=false;this.build();}
      build(){const shell=new THREE.MeshPhysicalMaterial({color:0x160b24,metalness:.9,roughness:.14,clearcoat:1,clearcoatRoughness:.08,emissive:C.magenta,emissiveIntensity:.65});this.body=new THREE.Mesh(new THREE.IcosahedronGeometry(3.15,2),shell);this.group.add(this.body);const cage=new THREE.Mesh(new THREE.IcosahedronGeometry(3.5,1),energyMaterial(C.magenta,.13));this.group.add(cage);this.core=new THREE.Mesh(new THREE.SphereGeometry(1.02,28,20),energyMaterial(C.magenta,.96));this.core.position.z=2.65;this.group.add(this.core);this.rings=[];for(const r of [3.7,4.25]){const ring=new THREE.Mesh(new THREE.TorusGeometry(r,.055,8,64),energyMaterial(r>4?C.cyan:C.magenta,.55));ring.rotation.set(rand(0,Math.PI),rand(0,Math.PI),rand(0,Math.PI));this.group.add(ring);this.rings.push(ring);}this.nodes=[];for(let i=0;i<3;i++){const pivot=new THREE.Group(),node=new THREE.Mesh(new THREE.DodecahedronGeometry(.72,1),energyMaterial(C.cyan,.9));pivot.rotation.z=i*Math.PI*2/3;node.position.y=4.6;pivot.add(node);this.group.add(pivot);this.nodes.push({pivot,mesh:node,hp:48,alive:true});}for(const s of [-1,1]){const arm=box(1.2,1.15,5.4,shell);arm.position.set(s*4.15,0,0);arm.rotation.z=s*.3;this.group.add(arm);const blade=new THREE.Mesh(new THREE.ConeGeometry(.55,2.2,10),energyMaterial(C.magenta,.62));blade.rotation.z=s*Math.PI/2;blade.position.x=s*7.1;this.group.add(blade);}}
      update(dt){if(this.dead)return;this.t+=dt;this.attack-=dt;this.group.position.x=Math.sin(this.t*.55)*5;this.group.position.y=3+Math.sin(this.t*1.3)*.45;this.body.rotation.x+=dt*.25;this.body.rotation.y+=dt*.4;this.rings[0].rotation.x+=dt*.42;this.rings[0].rotation.z-=dt*.31;this.rings[1].rotation.y-=dt*.5;for(const n of this.nodes)n.pivot.rotation.z+=dt*(this.phase===2?1.4:.8);if(this.hp<this.maxHp*.5&&this.phase===1){this.phase=2;game.toast('APEX PHASE // OVERDRIVE',C.magenta);game.flash(C.magenta,.3);game.shake=.65;}if(this.attack<.7)this.core.scale.setScalar(1.1+Math.sin(this.t*24)*.18);if(this.attack<=0){const count=this.phase===2?8:5;for(let i=0;i<count;i++){const o=this.group.position.clone().add(new THREE.Vector3(0,0,2));const d=player.group.position.clone().add(new THREE.Vector3((i-(count-1)/2)*.85,1,0)).sub(o).normalize();game.spawnEnemyBullet(o,d,this.phase===2?12:9);}audio.tone(130,.35,'sawtooth',.07,250);this.attack=this.phase===2?1.55:2.35;}this.core.scale.lerp(new THREE.Vector3(1,1,1),.1);}
      hit(b){for(const n of this.nodes)if(n.alive){const p=n.mesh.getWorldPosition(new THREE.Vector3());if(p.distanceTo(b.mesh.position)<1){n.hp-=b.damage;game.hits++;audio.hit(true);fx.burst(p,C.cyan,9,7);if(n.hp<=0){n.alive=false;n.mesh.visible=false;game.addScore(700);game.toast('SHIELD NODE DESTROYED',C.cyan);game.shake=.5;}return true;}}
        if(this.nodes.some(n=>n.alive))return this.body.getWorldPosition(new THREE.Vector3()).distanceTo(b.mesh.position)<3.5;
        const corePos=this.core.getWorldPosition(new THREE.Vector3()),crit=corePos.distanceTo(b.mesh.position)<1.25;if(this.group.positi