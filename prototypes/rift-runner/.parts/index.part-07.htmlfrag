      updateHUD(){const hp=clamp(player.hp,0,100),ult=clamp(player.ult,0,100);$('#health-fill').style.width=hp+'%';$('#health-fill').style.background=hp<30?'linear-gradient(90deg,#7d071d,#ff3158)':'';$('#ult-fill').style.width=ult+'%';$('#score').textContent=Math.round(this.score).toString().padStart(6,'0');$('#upgrade').textContent='WEAPON // '+player.upgrade;$('#timer').textContent=formatTime(this.runTime);$('#wave').textContent=this.state===STATE.BOSS?'BOSS WAVE // APEX':'WAVE '+String(this.wave).padStart(2,'0')+' // '+(this.route==='NONE'?'CORE':this.route);const mult=1+Math.min(4,this.combo*.08);$('#combo').style.opacity=this.combo>.1?'1':'0';$('#combo').innerHTML='×'+mult.toFixed(1)+'<br><span class="label">COMBO</span>';$('#boss-wrap').style.display=this.boss?'block':'none';if(this.boss)$('#boss-fill').style.width=clamp(this.boss.hp/this.boss.maxHp*100,0,100)+'%';}
      flash(color,dur=.2){const el=$('#flash');el.style.background='#'+color.toString(16).padStart(6,'0');el.style.opacity=this.reduced?'.15':'.72';setTimeout(()=>el.style.opacity='0',dur*1000);}
      toast(text,color=C.white){const el=$('#toast');el.textContent=text;el.style.color='#'+color.toString(16).padStart(6,'0');el.style.opacity='1';el.style.transform='translate(-50%,-50%) scale(1)';setTimeout(()=>{el.style.opacity='0';el.style.transform='translate(-50%,-50%) scale(1.12)'},1200);}
      finish(won){if(this.state===STATE.RESULTS||this.state===STATE.INITIALS)return;this.won=won;if(won)this.addScore(3000+Math.max(0,4000-this.runTime*8));this.accuracy=this.shots?this.hits/this.shots*100:0;this.grade=this.score>90000?'S':this.score>60000?'A':this.score>35000?'B':this.score>18000?'C':'D';for(const e of [...this.enemies])e.destroy(false);for(const b of [...this.playerBullets,...this.enemyBullets])this.removeBullet(b);if(this.boss){this.boss.destroy();this.boss=null;}world.clearDynamic();$('#hud').style.display='none';this.qualifies=this.highScores.length<10||this.score>this.highScores[this.highScores.length-1].score;if(this.qualifies){this.state=STATE.INITIALS;this.stateTime=0;this.initials=['A','A','A'];this.initialPos=0;this.initialCooldown=0;this.showInitials();}else this.showResults();}
      showInitials(){this.renderInitials();$('#screen').style.display='flex';$('#panel').innerHTML='<div class="tag">'+(this.won?'WAVE RUN COMPLETE':'PROTOCOL FAILED')+'</div><div class="prompt">NEW HIGH SCORE</div><div id="initial-box"></div><div class="small">↑ ↓ CHANGE &nbsp; ← → MOVE &nbsp; ENTER CONFIRM</div>';this.renderInitials();}
      renderInitials(){const boxEl=$('#initial-box');if(!boxEl)return;boxEl.innerHTML=this.initials.map((c,i)=>'<span class="'+(i===this.initialPos?'active-char':'')+'">'+c+'</span>').join(' ');}
      updateInitials(dt){this.stateTime+=dt;this.initialCooldown-=dt;let changed=false;if(this.initialCooldown<=0){if(input.edge('start')){if(this.initialPos<2)this.initialPos++;else{this.highScores.push({name:this.initials.join(''),score:Math.round(this.score)});this.highScores.sort((a,b)=>b.score-a.score);this.highScores=this.highScores.slice(0,10);this.saveScores();audio.ui();this.showResults();input.end();return;}}const up=input.pressed(['ArrowUp'])||(input.pad.aimY<-.6),down=input.pressed(['ArrowDown'])||(input.pad.aimY>.6),left=input.pressed(['ArrowLeft'])||(input.pad.aimX<-.6),right=input.pressed(['ArrowRight'])||(input.pad.aimX>.6);if(up||down){let n=this.initials[this.initialPos].charCodeAt(0)+(up?1:-1);if(n>90)n=65;if(n<65)n=90;this.initials[this.initialPos]=String.fromCharCode(n);changed=true;}if(left||right){this.initialPos=clamp(this.initialPos+(right?1:-1),0,2);changed=true;}if(changed){this.initialCooldown=.17;audio.ui();this.renderInitials();}}
      }
      showResults(){this.state=STATE.RESULTS;this.stateTime=0;$('#screen').style.display='flex';const rows=this.highScores.slice(0,5).map((s,i)=>'<tr><td>'+(i+1)+'</td><td>'+s.name+'</td><td>'+s.score.toLocaleString()+'</td></tr>').join('');$('#panel').innerHTML='<div class="tag">'+(this.won?'WAVE PROTOCOL CLEARED':'RUN TERMINATED')+'</div><div class="prompt">GRADE '+this.grade+' // '+Math.round(this.score).toLocaleString()+'</div><div class="stats"><div class="stat"><b>'+this.accuracy.toFixed(1)+'%</b><span>ACCURACY</span></div><div class="stat"><b>×'+(1+Math.min(4,this.maxCombo*.08)).toFixed(1)+'</b><span>MAX COMBO</span></div><div class="stat"><b>'+formatTime(this.runTime)+'</b><span>TIME</span></div><div class="stat"><b>'+Math.round(this.damageTaken)+'</b><span>DAMAGE</span></div><div class="stat"><b>'+this.route+'</b><span>ROUTE</span></div><div class="stat"><b>'+this.wave+'</b><span>WAVES</span></div></div><table class="scores">'+rows+'</table><div class="prompt">PRESS ENTER TO RUN AGAIN</div><div class="small">Returns to attract mode in 30 seconds</div>';}
      showAttract(){for(const e of [...this.enemies])e.destroy(false);for(const b of [...this.playerBullets,...this.enemyBullets])this.removeBullet(b);if(this.boss){this.boss.destroy();this.boss=null;}world.clearDynamic();this.state=STATE.ATTRACT;this.stateTime=0;this.paused=false;player.group.visible=true;player.group.position.set(0,0,2);$('#pause').style.display='none';$('#hud').style.display='none';$('#screen').style.display='flex';const rows=this.highScores.slice(0,5).map((s,i)=>'<tr><td>'+(i+1)+'</td><td>'+s.name+'</td><td>'+s.score.toLocaleString()+'</td></tr>').join('');$('#panel').innerHTML='<h1>Rift<br>Runner</h1><div class="tag">Wave Protocol // Survive. Accelerate. Dominate.</div><div class="prompt">PRESS ENTER / START</div><div class="keys"><span><b>WASD</b> MOVE</span><span><b>ARROWS</b> AIM</span><span><b>Z</b> FIRE</span><span><b>X</b> DODGE</span><span><b>C</b> OVERDRIVE</span></div><table class="scores">'+rows+'</table><div class="small">MOUSE + GAMEPAD SUPPORTED &nbsp; // &nbsp; F FULLSCREEN &nbsp; M MUTE &nbsp; V REDUCED FX</div>';}
      togglePause(){this.paused=!this.paused;$('#pause').style.display=this.paused?'flex':'none';if(!this.paused)clock.getDelta();}
    }

    function formatTime(s){const m=Math.floor(s/60),sec=s-m*60;return String(m).padStart(2,'0')+':'+sec.toFixed(1).padStart(4,'0')}
    function init(){scene=new THREE.Scene();scene.background=new THREE.Color(C.dark);scene.fog=new THREE.FogExp2(0x050713,.018);camera=new THREE.PerspectiveCamera(62,innerWidth/innerHeight,.1,240);renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance',stencil:false});renderer.setPixelRatio(Math.min(devicePixelRatio,1.65));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.08;renderer.outputColorSpace=THREE.SRGBColorSpace;document.body.prepend(renderer.domElement);
      scene.add(new THREE.HemisphereLight(0x5d8cff,0x120517,1.45));const sun=new THREE.DirectionalLight(0xc6f4ff,3.2);sun.position.set(5,11,7);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-18;sun.shadow.camera.right=18;sun.shadow.camera.top=18;sun.shadow.camera.bottom=-18;sun.shadow.bias=-.0004;scene.add(sun);const mag=new THREE.PointLight(C.magenta,55,55,2);mag.position.set(-12,7,-35);scene.add(mag);const cyan=new THREE.PointLight(C.cyan,40,60,2);cyan.position.set(10,6,-55);scene.add(cyan);const key=new THREE.SpotLight(0xffffff,110,90,.5,.7,1.4);key.position.set(0,16,-12);key.target.position.set(0,0,-35);scene.add(key,key.target);
      composer=new EffectComposer(renderer);composer.addPass(new RenderPass(scene,camera));bloomPass=new UnrealBloomPass(new THREE.Vector2(innerWidth,innerHeight),1.25,.58,.19);composer.addPass(bloomPass);composer.addPass(new OutputPass());
      clock=new THREE.Clock();world=new World();player=new Player();fx=new FXPool();game=new Game();applyToggles();addEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(document.hidden&&PLAY_STATES.has(game.state)&&!game.paused)game.togglePause()});loop();}
