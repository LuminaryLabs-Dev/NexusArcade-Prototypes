i*12;this.group.add(g);this.segments.push(g);}
        const sky=new THREE.Mesh(new THREE.SphereGeometry(170,32,18),new THREE.ShaderMaterial({side:THREE.BackSide,depthWrite:false,uniforms:{uTime:shaderClock},vertexShader:`varying vec3 vP;void main(){vP=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,fragmentShader:`uniform float uTime;varying vec3 vP;float h(float n){return fract(sin(n)*43758.5453);}void main(){vec3 d=normalize(vP);float horizon=pow(max(0.,1.-abs(d.y)),5.);float stars=step(.997,h(floor(d.x*420.)+floor(d.y*380.)*613.));vec3 c=mix(vec3(.002,.003,.012),vec3(.025,.01,.06),horizon)+vec3(.08,.34,.52)*horizon*.28+vec3(stars);gl_FragColor=vec4(c,1.);}`}));scene.add(sky);
        this.horizonGlow=new THREE.Mesh(new THREE.PlaneGeometry(70,30),new THREE.ShaderMaterial({transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,uniforms:{uTime:shaderClock},vertexShader:`varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,fragmentShader:`uniform float uTime;varying vec2 vUv;void main(){vec2 p=vUv-.5;float beam=exp(-abs(p.y)*13.)*exp(-abs(p.x)*2.2);float towers=step(.93,fract((vUv.x+sin(floor(vUv.x*18.))*0.02)*18.))*smoothstep(.08,.45,vUv.y);vec3 c=mix(vec3(.06,.85,1.),vec3(1.,.02,.55),vUv.x);gl_FragColor=vec4(c,(beam*.65+towers*.12)*(.8+.2*sin(uTime*2.)));}`}));this.horizonGlow.position.set(0,6,-145);scene.add(this.horizonGlow);
        const streamPos=new Float32Array(760*3);for(let i=0;i<760;i++){streamPos[i*3]=rand(-30,30);streamPos[i*3+1]=rand(-2,18);streamPos[i*3+2]=rand(-150,12);}const streamGeo=new THREE.BufferGeometry();streamGeo.setAttribute('position',new THREE.BufferAttribute(streamPos,3));this.streams=new THREE.Points(streamGeo,new THREE.PointsMaterial({color:C.cyan,size:.085,transparent:true,opacity:.68,blending:THREE.AdditiveBlending,depthWrite:false}));scene.add(this.streams);
        this.shafts=[];for(let i=0;i<8;i++){const shaft=new THREE.Mesh(new THREE.ConeGeometry(rand(1.5,3.5),rand(18,35),12,1,true),new THREE.MeshBasicMaterial({color:i%2?C.cyan:C.magenta,transparent:true,opacity:.025,depthWrite:false,blending:THREE.AdditiveBlending,side:THREE.DoubleSide}));shaft.rotation.x=Math.PI;shaft.position.set(rand(-18,18),rand(11,20),rand(-130,-35));scene.add(shaft);this.shafts.push(shaft);}
      }
      update(dt,speed){this.floorMat.uniforms.uSpeed.value=speed;for(const s of this.segments){s.position.z+=speed*dt;if(s.position.z>18)s.position.z-=192;}const attr=this.streams.geometry.attributes.position,a=attr.array;for(let i=2;i<a.length;i+=3){a[i]+=speed*dt*(1.15+Math.abs(a[i-2])*.02);if(a[i]>14)a[i]=rand(-155,-110);}attr.needsUpdate=true;this.streams.material.size=game?.reduced?.055:.085+Math.min(speed,14)*.003;$('#speed-fx').style.opacity=String(game?.reduced?0:clamp((speed-3)/18,0,.3));for(let i=0;i<this.shafts.length;i++)this.shafts[i].rotation.z+=dt*(i%2?.015:-.012);
        for(const h of [...this.hazards]){h.mesh.position.z+=(speed+8)*dt;h.mesh.rotation.z+=dt*2;if(h.mesh.position.z>8){if(Math.abs(h.mesh.position.x-player.group.position.x)<2.2)player.damage(14);else game.addScore(175);this.removeHazard(h);}}
        for(const b of [...this.barrels]){b.mesh.position.z+=speed*dt;b.mesh.rotation.y+=dt*1.3;if(b.mesh.position.z>10)this.removeBarrel(b);}
      }
      spawnHazard(){const m=new THREE.Group(),blade=box(3.4,.42,.5,mat(0x30120a,C.orange,2.7)),core=cyl(.34,2.5,energyMaterial(C.orange,.8));core.rotation.z=Math.PI/2;m.add(blade,core);for(const s of [-1,1]){const tip=new THREE.Mesh(new THREE.ConeGeometry(.42,1.2,8),mat(0x30120a,C.orange,2));tip.rotation.z=s*Math.PI/2;tip.position.x=s*2;m.add(tip);}m.position.set(choose([-6,-3,0,3,6]),1.2,rand(-55,-40));scene.add(m);this.hazards.push({mesh:m});}
      removeHazard(h){scene.remove(h.mesh);this.hazards.splice(this.hazards.indexOf(h),1)}
      spawnBarrel(){const m=new THREE.Group(),body=cyl(.58,1.55,mat(0x241015,C.orange,1.1)),core=cyl(.32,1.65,energyMaterial(C.orange,.85));m.add(body,core);for(const y of [-.55,.55]){const ring=new THREE.Mesh(new THREE.TorusGeometry(.62,.08,8,18),mat(0x3b2420,C.orange,1.5));ring.rotation.x=Math.PI/2;ring.position.y=y;m.add(ring);}m.position.set(rand(-7,7),.78,rand(-45,-28));scene.add(m);this.barrels.push({mesh:m,hp:1});}
      hitBarrels(bullet){for(const b of [...this.barrels])if(bullet.mesh.position.distanceTo(b.mesh.position)<1.1){this.explodeBarrel(b);return true}return false}
      explodeBarrel(b){const p=b.mesh.position.clone();fx.burst(p,C.orange,22,10);audio.boom();let kills=0;for(const e of [...game.enemies])if(e.group.position.distanceTo(p)<6){const was=e.hp>0;e.takeDamage(200,true);if(was&&e.hp<=0)kills++;}game.envKills+=kills;game.addScore(150+kills*350);this.removeBarrel(b);game.shake=.3;}
      removeBarrel(b){scene.remove(b.mesh);this.barrels.splice(this.barrels.indexOf(b),1)}
      clearDynamic(){for(const h of [...this.hazards])this.removeHazard(h);for(const b of [...this.barrels])this.removeBarrel(b);for(const g of this.gates)scene.remove(g.group);this.gates=[];}
      makeGates(){this.clearDynamic();for(const [side,title,color] of [[-1,'ONSLAUGHT',C.orange],[1,'ARSENAL',C.cyan]]){const g=new THREE.Group();for(const x of [-2.8,2.8]){const post=box(.5,6,.7,mat(0x101426,color,2));post.position.set(x,3,0);g.add(post);}const top=box(6,.5,.7,mat(0x101426,color,2));top.position.y=6;g.add(top);const field=new THREE.Mesh(new THREE.PlaneGeometry(5.2,5.2),energyMaterial(color,.25));field.position.set(0,3,.12);g.add(field);const sign=makeTextSprite(title,color);sign.position.set(0,7.1,0);sign.scale.set(5,1.2,1);g.add(sign);g.position.set(side*4.7,0,-18);scene.add(g);this.gates.push({side,group:g,hit:false});}}
      hitGates(b){for(const g of this.gates)if(b.mesh.position.distanceTo(g.group.position.clone().add(new THREE.Vector3(0,3,0)))<3.8){game.chooseRoute(g.side);return true}return false}
    }

    function makeTextSprite(text,color){const c=document.createElement('canvas');c.width=512;c.height=128;const x=c.getContext('2d');x.fillStyle='rgba(3,5,12,.88)';x.fillRect(0,0,512,128);x.strokeStyle='#'+color.toString(16).padStart(6,'0');x.lineWidth=8;x.strokeRect(5,5,502,118);x.fillStyle='#fff';x.font='900 52px Arial';x.textAlign='center';x.textBaseline='middle';x.fillText(text,256,66);const t=new THREE.CanvasTexture(c);return new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true}));}

    class Player{
      constructor(){this.group=new THREE.Group();scene.add(this.group);this.hp=100;this.ult=0;this.cool=0;this.dodgeCool=0;this.dodgeT=0;this.invuln=0;this.upgrade='STANDARD';this.upgradeTime=0;this.build();}
      build(){const armor=new THREE.MeshPhysicalMaterial({color:0x102d3d,metalness:.82,roughness:.2,clearcoat:1,clearcoatRoughness:.15,emissive:C.cyan,emissiveIntensity:.52}),dark=mat(0x080b12,0x03070e,.12),carbon=mat(0x151923,0x07111b,.2),glow=energyMaterial(C.cyan,.86);
        this.body=box(1.02,1.25,.68,armor);this.body.position.y=1.47;this.group.add(this.body);const waist=cyl(.38,.3,dark);waist.position.y=.78;this.group.add(waist);const chest=new THREE.Mesh(new THREE.OctahedronGeometry(.34,0),glow);chest.scale.set(1.25,.72,.38);chest.position.set(0,1.6,-.43);this.group.