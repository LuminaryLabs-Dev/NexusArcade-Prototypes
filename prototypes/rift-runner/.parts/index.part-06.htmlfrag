on.distanceTo(b.mesh.position)<4){this.hp-=b.damage*(crit?2:1);game.hits++;game.addScore(crit?45:15);game.charge(crit?3:1);audio.hit(crit);fx.burst(b.mesh.position,crit?C.orange:C.magenta,crit?8:3,5);if(this.hp<=0)this.defeat();return true}return false;}
      ultimateHit(){for(const n of this.nodes)if(n.alive){n.hp-=25;if(n.hp<=0){n.alive=false;n.mesh.visible=false;}}if(!this.nodes.some(n=>n.alive)){this.hp-=75;if(this.hp<=0)this.defeat();}}
      defeat(){if(this.dead)return;this.dead=true;game.addScore(5000);fx.burst(this.group.position,C.magenta,70,22);audio.boom();game.flash(C.white,.65);game.shake=1.2;setTimeout(()=>{scene.remove(this.group);game.boss=null;if(game.state===STATE.BOSS)game.setState(STATE.EXTRACT);},900);}
      destroy(){scene.remove(this.group);this.dead=true;}
    }

    class Game{
      constructor(){this.state=STATE.ATTRACT;this.stateTime=0;this.totalTime=0;this.runTime=0;this.speed=0;this.enemies=[];this.playerBullets=[];this.enemyBullets=[];this.bulletPool={player:[],enemy:[]};this.spawnClock=0;this.shake=0;this.route='NONE';this.reduced=this.pref('rrReduced')==='1';this.muted=this.pref('rrMuted')==='1';audio.muted=this.muted;this.aimTarget=new THREE.Vector3();this.highScores=this.loadScores();this.showAttract();}
      pref(key){try{return localStorage.getItem(key)}catch{return null}}
      loadScores(){try{return JSON.parse(localStorage.getItem('riftRunnerScores'))||[{name:'ACE',score:120000},{name:'NXR',score:75000},{name:'RUN',score:42000}]}catch{return[]}}
      saveScores(){try{localStorage.setItem('riftRunnerScores',JSON.stringify(this.highScores.slice(0,10)))}catch{}}
      resetRun(){for(const e of [...this.enemies])e.destroy(false);for(const b of [...this.playerBullets,...this.enemyBullets])this.removeBullet(b);if(this.boss)this.boss.destroy();this.boss=null;world.clearDynamic();player.reset();Object.assign(this,{score:0,combo:0,comboTimer:0,maxCombo:0,shots:0,hits:0,kills:0,envKills:0,damageTaken:0,runTime:0,wave:0,route:'NONE',routeMultiplier:1,spawnClock:0,shake:0});}
      start(){audio.ensure();audio.ui();this.resetRun();$('#screen').style.display='none';$('#hud').style.display='block';this.setState(STATE.TUTORIAL);}
      setState(s){this.state=s;this.stateTime=0;this.spawnClock=0;world.clearDynamic();if(s===STATE.TUTORIAL){this.speed=5.5;this.toast('WAVE PROTOCOL ONLINE',C.cyan);}
        if(s===STATE.ESCAPE){this.speed=8;this.toast('WAVE STREAM // ENGAGED',C.magenta);}
        if(s===STATE.ARENA){this.speed=0;this.toast('ELITE WAVE INBOUND',C.orange);}
        if(s===STATE.ROUTE){this.speed=0;for(const e of [...this.enemies])e.destroy(false);world.makeGates();this.toast('SELECT NEXT WAVE',C.white);}
        if(s===STATE.ROUTE_RUN){this.speed=this.route==='ONSLAUGHT'?10:7;if(this.route==='ARSENAL')player.grant('CHAIN');}
        if(s===STATE.FINAL){this.speed=11;this.toast('APEX WAVES // MAXIMUM SPEED',C.cyan);}
        if(s===STATE.BOSS){this.speed=0;for(const e of [...this.enemies])e.destroy(false);this.wave++;this.boss=new ApexWarden();this.toast('BOSS WAVE // APEX WARDEN',C.magenta);}
        if(s===STATE.EXTRACT){this.speed=14;this.toast('WAVE PROTOCOL CLEARED',C.cyan);}
        this.updateObjective();}
      update(dt){this.totalTime+=dt;input.update(dt);if(input.edge('mute'))toggleMute();if(input.edge('effects'))toggleEffects();if(input.edge('fullscreen'))toggleFullscreen();if((input.edge('pause')||input.edge('start'))&&PLAY_STATES.has(this.state))this.togglePause();if(this.paused){input.end();return;}
        if(this.state===STATE.ATTRACT){this.updateAttract(dt);if(input.edge('start')||input.mouse.hit)this.start();input.end();return;}
        if(this.state===STATE.INITIALS){this.updateInitials(dt);input.end();return;}
        if(this.state===STATE.RESULTS){this.stateTime+=dt;if(input.edge('start')||input.mouse.hit)this.start();else if(this.stateTime>30)this.showAttract();input.end();return;}
        this.stateTime+=dt;this.runTime+=dt;this.comboTimer-=dt;if(this.comboTimer<=0)this.combo=Math.max(0,this.combo-dt*2.5);this.maxCombo=Math.max(this.maxCombo,this.combo);this.shake=Math.max(0,this.shake-dt*2);this.computeAim();player.update(dt);world.update(dt,this.speed);fx.update(dt);this.updateBullets(dt);for(const e of [...this.enemies])e.update(dt,this.speed);if(this.boss)this.boss.update(dt);this.spawnClock-=dt;this.runState();this.updateCamera(dt);this.updateHUD();input.end();}
      runState(){if(this.state===STATE.TUTORIAL){if(this.spawnClock<=0&&this.stateTime>3){this.spawnEnemy(this.stateTime<12?'drone':this.stateTime<20?'rusher':'turret');this.spawnClock=5;}if(this.stateTime>25)this.setState(STATE.ESCAPE);}
        else if(this.state===STATE.ESCAPE){if(this.spawnClock<=0){this.spawnWave(1+((this.stateTime/25)|0));if(Math.random()<.35)world.spawnBarrel();this.spawnClock=rand(3.8,5.8);}if(this.stateTime>70)this.setState(STATE.ARENA);}
        else if(this.state===STATE.ARENA){if(this.spawnClock<=0){this.spawnWave(2+((this.stateTime/24)|0));if(Math.random()<.5)world.spawnBarrel();this.spawnClock=5;}if(this.stateTime>60){player.grant(choose(['RAPID','SPREAD','PIERCE']));this.setState(STATE.ROUTE);}}
        else if(this.state===STATE.ROUTE){if(this.stateTime>20)this.chooseRoute(1);}
        else if(this.state===STATE.ROUTE_RUN){if(this.route==='ONSLAUGHT'){if(this.spawnClock<=0){world.spawnHazard();this.spawnWave(2+Math.min(2,(this.stateTime/22)|0));this.spawnClock=3.4;}}else if(this.spawnClock<=0){this.spawnWave(3);this.spawnClock=4.2;}if(this.stateTime>60)this.setState(STATE.FINAL);}
        else if(this.state===STATE.FINAL){if(this.spawnClock<=0){this.spawnWave(3+((this.stateTime/30)|0));if(Math.random()<.45)world.spawnBarrel();this.spawnClock=3.3;}if(this.stateTime>60)this.setState(STATE.BOSS);}
        else if(this.state===STATE.EXTRACT&&this.stateTime>8)this.finish(true);this.updateObjective();}
      computeAim(){const x=player.group.position.x+input.aim.x*10,y=1.4+input.aim.y*6.5,z=-22;this.aimTarget.set(x,y,z);const origin=player.group.position.clone().add(new THREE.Vector3(.5,1.5,-.5)),raw=this.aimTarget.clone().sub(origin).normalize();let best=null,bestDot=.982;for(const e of this.enemies){const p=e.weak.getWorldPosition(new THREE.Vector3()),d=p.clone().sub(origin).normalize(),dot=d.dot(raw);if(dot>bestDot){bestDot=dot;best=p;}}if(best)this.aimTarget.lerp(best,.28);const sx=50+input.aim.x*31,sy=50-input.aim.y*30,cross=$('#crosshair'),scale=input.fire ? .82 : best ? 1.12 : 1;cross.style.left=sx+'%';cross.style.top=sy+'%';cross.style.transform='translate(-50%,-50%) scale('+scale+') rotate('+(best?45:0)+'deg)';cross.style.filter='drop-shadow(0 0 '+(best?'11px #ff8a27':'6px #56f6ff')+')';}
      spawnEnemy(type=choose(['drone','rusher','turret','brute']),x=rand(-7,7),z=rand(-50,-27)){if(this.enemies.length>16)return;this.enemies.push(new Enemy(type,x,z));}
      spawnWave(n){this.wave++;const types=['drone','rusher','turret','brute'],pattern=this.wave%3;for(let i=0;i<n;i++){const type=types[Math.min(types.length-1,Math.random()*(2+this.runTime/115)|0)],x=pattern===0?(i-(n-1)/2)*2.6:pattern===1?(i%2?1:-1)*(2+i*1.1):rand(-7,7),z=-34-(pattern===2?i*5:Math.abs(i-(n-1)/2)*2.2);this.spawnEnemy(type,clamp(x,-7.4,7.4),z);}this.toast('