        this.stateTime+=dt;this.runTime+=dt;this.comboTimer-=dt;if(this.comboTimer<=0)this.combo=Math.max(0,this.combo-dt*2.5);this.maxCombo=Math.max(this.maxCombo,this.combo);this.shake=Math.max(0,this.shake-dt*2);this.computeAim();player.update(dt);world.update(dt,this.speed);fx.update(dt);this.updateBullets(dt);for(const e of [...this.enemies])e.update(dt,this.speed);if(this.boss)this.boss.update(dt);this.spawnClock-=dt;this.runState();this.updateCamera(dt);this.updateHUD();input.end();}
      runState(){if(this.state===STATE.TUTORIAL){if(this.spawnClock<=0&&this.stateTime>3){this.spawnEnemy(this.stateTime<12?'drone':this.stateTime<20?'rusher':'turret');this.spawnClock=5;}if(this.stateTime>25)this.setState(STATE.ESCAPE);}
        else if(this.state===STATE.ESCAPE){if(this.spawnClock<=0){this.spawnWave(1+((this.stateTime/25)|0));if(Math.random()<.35)world.spawnBarrel();this.spawnClock=rand(3.8,5.8);}if(this.stateTime>70)this.setState(STATE.ARENA);}
        else if(this.state===STATE.ARENA){if(this.spawnClock<=0){this.spawnWave(2+((this.stateTime/24)|0));if(Math.random()<.5)world.spawnBarrel();this.spawnClock=5;}if(this.stateTime>60){player.grant(choose(['RAPID','SPREAD','PIERCE']));this.setState(STATE.ROUTE);}}
        else if(this.state===STATE.ROUTE){if(this.stateTime>20)this.chooseRoute(1);}
        else if(this.state===STATE.ROUTE_RUN){if(this.route==='ONSLAUGHT'){if(this.spawnClock<=0){world.spawnHazard();this.spawnWave(2+Math.min(2,(this.stateTime/22)|0));this.spawnClock=3.4;}}else if(this.spawnClock<=0){this.spawnWave(3);this.spawnClock=4.2;}if(this.stateTime>60)this.setState(STATE.FINAL);}
        else if(this.state===STATE.FINAL){if(this.spawnClock<=0){this.spawnWave(3+((this.stateTime/30)|0));if(Math.random()<.45)world.spawnBarrel();this.spawnClock=3.3;}if(this.stateTime>60)this.setState(STATE.BOSS);}
        else if(this.state===STATE.EXTRACT&&this.stateTime>8)this.finish(true);this.updateObjective();}
      computeAim(){const x=player.group.position.x+input.aim.x*10,y=1.4+input.aim.y*6.5,z=-22;this.aimTarget.set(x,y,z);const origin=player.group.position.clone().add(new THREE.Vector3(.5,1.5,-.5)),raw=this.aimTarget.clone().sub(origin).normalize();let best=null,bestDot=.982;for(const e of this.enemies){const p=e.weak.getWorldPosition(new THREE.Vector3()),d=p.clone().sub(origin).normalize(),dot=d.dot(raw);if(dot>bestDot){bestDot=dot;best=p;}}if(best)this.aimTarget.lerp(best,.28);const sx=50+input.aim.x*31,sy=50-input.aim.y*30,cross=$('#crosshair'),scale=input.fire ? .82 : best ? 1.12 : 1;cross.style.left=sx+'%';cross.style.top=sy+'%';cross.style.transform='translate(-50%,-50%) scale('+scale+') rotate('+(best?45:0)+'deg)';cross.style.filter='drop-shadow(0 0 '+(best?'11px #ff8a27':'6px #56f6ff')+')';}
      spawnEnemy(type=choose(['drone','rusher','turret','brute']),x=rand(-7,7),z=rand(-50,-27)){if(this.enemies.length>16)return;this.enemies.push(new Enemy(type,x,z));}
      spawnWave(n){this.wave++;const types=['drone','rusher','turret','brute'],pattern=this.wave%3;for(let i=0;i<n;i++){const type=types[Math.min(types.length-1,Math.random()*(2+this.runTime/115)|0)],x=pattern===0?(i-(n-1)/2)*2.6:pattern===1?(i%2?1:-1)*(2+i*1.1):rand(-7,7),z=-34-(pattern===2?i*5:Math.abs(i-(n-1)/2)*2.2);this.spawnEnemy(type,clamp(x,-7.4,7.4),z);}this.toast('WAVE '+String(this.wave).padStart(2,'0'),this.wave%5===0?C.orange:C.cyan);}
      acquireBullet(isPlayer){const key=isPlayer?'player':'enemy',pool=this.bulletPool[key];let b=pool.pop();if(!b){const color=isPlayer?C.cyan:C.red,mesh=new THREE.Group(),core=new THREE.Mesh(new THREE.SphereGeometry(isPlayer?.13:.19,10,8),energyMaterial(color,.98)),trail=new THREE.Mesh(new THREE.ConeGeometry(isPlayer?.13:.2,isPlayer?1.8:1.3,10,1,true),energyMaterial(color,.34));trail.rotation.x=Math.PI/2;trail.position.z=.78;mesh.add(core,trail);scene.add(mesh);b={mesh,vel:new THREE.Vector3(),life:0,damage:0,pierce:0,player:isPlayer};}b.mesh.visible=true;return b;}
      spawnPlayerBullet(pos,dir,pierce=0){const b=this.acquireBullet(true);b.mesh.position.copy(pos);b.vel.copy(dir).multiplyScalar(48);b.mesh.lookAt(pos.clone().add(dir));b.life=1.2;b.damage=20;b.pierce=pierce;this.playerBullets.push(b);}
      spawnEnemyBullet(pos,dir,damage){const b=this.acquireBullet(false);b.mesh.position.copy(pos);b.vel.copy(dir).multiplyScalar(13);b.mesh.lookAt(pos.clone().add(dir));b.life=3;b.damage=damage;this.enemyBullets.push(b);}
      updateBullets(dt){for(const b of [...this.playerBullets,...this.enemyBullets]){b.life-=dt;b.mesh.position.addScaledVector(b.vel,dt);if(b.player){let hit=false;if(world.hitGates(b)||world.hitBarrels(b))hit=true;if(!hit&&this.boss)hit=this.boss.hit(b);if(!hit)for(const e of [...this.enemies]){const center=e.group.position.clone().add(new THREE.Vector3(0,e.type==='drone'?0:1,0));if(center.distanceTo(b.mesh.position)<e.radius){const wp=e.weak.getWorldPosition(new THREE.Vector3()),crit=wp.distanceTo(b.mesh.position)<.55;e.takeDamage(b.damage,false,crit);this.hits++;this.addScore(crit?45:12);this.charge(crit?4:1.2);if(player.upgrade==='CHAIN')this.chainFrom(e);hit=true;break;}}if(hit){if(b.pierce>0)b.pierce--;else this.removeBullet(b);}}
          else if(b.mesh.position.distanceTo(player.group.position.clone().add(new THREE.Vector3(0,1,0)))<.75){player.damage(b.damage);this.removeBullet(b);}if(b.life<=0||Math.abs(b.mesh.position.z)>90)this.removeBullet(b);}}
      chainFrom(origin){const other=this.enemies.find(e=>e!==origin&&e.group.position.distanceTo(origin.group.position)<6);if(other){other.takeDamage(9,false,false);const a=origin.weak.getWorldPosition(new THREE.Vector3()),b=other.weak.getWorldPosition(new THREE.Vector3());fx.arc(a,b,C.cyan);fx.burst(b,C.cyan,4,3);}}
      removeBullet(b){let a=b.player?this.playerBullets:this.enemyBullets;const i=a.indexOf(b);if(i<0)return;a.splice(i,1);b.mesh.visible=false;b.life=0;this.bulletPool[b.player?'player':'enemy'].push(b);}
      addScore(n){this.score+=Math.round(n*(1+Math.min(4,this.combo*.08))*this.routeMultiplier);}
      onKill(){this.kills++;this.combo+=1;this.comboTimer=3.5;this.charge(6);}
      charge(n){player.ult=clamp(player.ult+n,0,100);}
      chooseRoute(side){if(this.state!==STATE.ROUTE)return;this.route=side<0?'ONSLAUGHT':'ARSENAL';this.routeMultiplier=side<0?1.5:1;this.addScore(side<0?750:350);audio.ui();this.setState(STATE.ROUTE_RUN);this.toast(this.route,C.orange);}
      updateCamera(dt){if(this.state===STATE.ATTRACT)return;const p=player.group.position,targetPos=new THREE.Vector3(p.x+3.2,3.7,p.z+7.4);camera.position.lerp(targetPos,1-Math.pow(.001,dt));const shake=this.reduced?0:this.shake;camera.position.x+=rand(-shake,shake)*.12;camera.position.y+=rand(-shake,shake)*.09;camera.fov=lerp(camera.fov,62+Math.min(this.speed,14)*.42+(player.dodgeT>0?7:0),.08);camera.updateProjectionMatrix();camera.lookAt(p.x+input.aim.x*2.3,1.45+input.aim.y*1.5,p.z-8);}
      updateAttract(dt){this.stateTime+=dt;const a=this.totalTime*.16;camera.position.set(Math.sin(a)*14,5.2+Math.sin(a*.7),Math.cos(a)*14-5);camera.lookAt(0,1,-6);world.update(dt,2.5);fx.update(dt);}
      updateObjective(){let t='';if(this.state===STATE.TUTORIAL)t=this.stateTime<7?'CALIBRATE MOVEMENT + AIM':this.stateTime<15?'ERASE THE FIRST WAVE':this.stateTime<22?'DODGE TELEGRAPHED ATTACKS':'CHARGE OVERDRIVE';if(this.state===STATE.ESCAPE)t='BREAK THE ASSAULT WAVES';if(this.state===STATE.ARENA)t='ELITE HOLDOUT // '+Math.max(0,Math.ceil(60-this.stateTime))+'s';if(this.state===STATE.ROUTE)t='LEFT: ONSLAUGHT // RIGHT: ARSENAL';if(this.state===STATE.ROUTE_RUN)t=this.route==='ONSLAUGHT'?'SURVIVE THE BONUS MULTIPLIER':'CLEAR THE ARSENAL WAVES';if(this.state===STATE.FINAL)t='APEX WAVES INBOUND';if(this.state===STATE.BOSS)t=this.boss?.nodes.some(n=>n.alive)?'SHATTER THE APEX SHIELD':'OVERLOAD THE CORE';if(this.state===STATE.EXTRACT)t='WAVE CLEAR // EXTRACTION';$('#objective').textContent=t;}
