c,i)=>'<span class="'+(i===this.initialPos?'active-char':'')+'">'+c+'</span>').join(' ');}
      updateInitials(dt){this.stateTime+=dt;this.initialCooldown-=dt;let changed=false;if(this.initialCooldown<=0){if(input.edge('start')){if(this.initialPos<2)this.initialPos++;else{this.highScores.push({name:this.initials.join(''),score:Math.round(this.score)});this.highScores.sort((a,b)=>b.score-a.score);this.highScores=this.highScores.slice(0,10);this.saveScores();audio.ui();this.showResults();input.end();return;}}const up=input.pressed(['ArrowUp'])||(input.pad.aimY<-.6),down=input.pressed(['ArrowDown'])||(input.pad.aimY>.6),left=input.pressed(['ArrowLeft'])||(input.pad.aimX<-.6),right=input.pressed(['ArrowRight'])||(input.pad.aimX>.6);if(up||down){let n=this.initials[this.initialPos].charCodeAt(0)+(up?1:-1);if(n>90)n=65;if(n<65)n=90;this.initials[this.initialPos]=String.fromCharCode(n);changed=true;}if(left||right){this.initialPos=clamp(this.initialPos+(right?1:-1),0,2);changed=true;}if(changed){this.initialCooldown=.17;audio.ui();this.renderInitials();}}
      }
      showResults(){this.state=STATE.RESULTS;this.stateTime=0;$('#screen').style.display='flex';const rows=this.highScores.slice(0,5).map((s,i)=>'<tr><td>'+(i+1)+'</td><td>'+s.name+'</td><td>'+s.score.toLocaleString()+'</td></tr>').join('');$('#panel').innerHTML='<div class="tag">'+(this.won?'WAVE PROTOCOL CLEARED':'RUN TERMINATED')+'</div><div class="prompt">GRADE '+this.grade+' // '+Math.round(this.score).toLocaleString()+'</div><div class="stats"><div class="stat"><b>'+this.accuracy.toFixed(1)+'%</b><span>ACCURACY</span></div><div class="stat"><b>×'+(1+Math.min(4,this.maxCombo*.08)).toFixed(1)+'</b><span>MAX COMBO</span></div><div class="stat"><b>'+formatTime(this.runTime)+'</b><span>TIME</span></div><div class="stat"><b>'+Math.round(this.damageTaken)+'</b><span>DAMAGE</span></div><div class="stat"><b>'+this.route+'</b><span>ROUTE</span></div><div class="stat"><b>'+this.wave+'</b><span>WAVES</span></div></div><table class="scores">'+rows+'</table><div class="prompt">ENTER / CLICK / START TO RUN AGAIN</div><div class="small">Returns to attract mode in 30 seconds</div>';}
      showAttract(){for(const e of [...this.enemies])e.destroy(false);for(const b of [...this.playerBullets,...this.enemyBullets])this.removeBullet(b);if(this.boss){this.boss.destroy();this.boss=null;}world.clearDynamic();this.state=STATE.ATTRACT;this.stateTime=0;this.paused=false;player.group.visible=true;player.group.position.set(0,0,2);$('#pause').style.display='none';$('#hud').style.display='none';$('#screen').style.display='flex';const rows=this.highScores.slice(0,5).map((s,i)=>'<tr><td>'+(i+1)+'</td><td>'+s.name+'</td><td>'+s.score.toLocaleString()+'</td></tr>').join('');$('#panel').innerHTML='<h1>Rift<br>Runner</h1><div class="tag">Wave Protocol // Survive. Accelerate. Dominate.</div><div class="prompt">PRESS ENTER / CLICK / START</div><div class="keys"><span><b>WASD</b> MOVE</span><span><b>MOUSE</b> AIM</span><span><b>LEFT CLICK</b> FIRE</span><span><b>SPACE</b> DODGE</span><span><b>Q / E</b> OVERDRIVE</span></div><table class="scores">'+rows+'</table><div class="small">GAMEPAD: LS MOVE · RS AIM · RT FIRE · A DODGE · B OVERDRIVE<br>ARCADE: ARROWS AIM · Z FIRE · X DODGE · C OVERDRIVE &nbsp; // &nbsp; F FULLSCREEN · M MUTE · V FX</div>';}
      togglePause(){this.paused=!this.paused;$('#pause').style.display=this.paused?'flex':'none';if(!this.paused)clock.getDelta();}
    }

    function formatTime(s){const m=Math.floor(s/60),sec=s-m*60;return String(m).padStart(2,'0')+':'+sec.toFixed(1).padStart(4,'0')}
    function init(){scene=new THREE.Scene();scene.background=new THREE.Color(C.dark);scene.fog=new THREE.FogExp2(0x050713,.018);camera=new THREE.PerspectiveCamera(62,innerWidth/innerHeight,.1,240);renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance',stencil:false});renderer.setPixelRatio(Math.min(devicePixelRatio,1.65));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.08;renderer.outputColorSpace=THREE.SRGBColorSpace;document.body.prepend(renderer.domElement);
      scene.add(new THREE.HemisphereLight(0x5d8cff,0x120517,1.45));const sun=new THREE.DirectionalLight(0xc6f4ff,3.2);sun.position.set(5,11,7);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-18;sun.shadow.camera.right=18;sun.shadow.camera.top=18;sun.shadow.camera.bottom=-18;sun.shadow.bias=-.0004;scene.add(sun);const mag=new THREE.PointLight(C.magenta,55,55,2);mag.position.set(-12,7,-35);scene.add(mag);const cyan=new THREE.PointLight(C.cyan,40,60,2);cyan.position.set(10,6,-55);scene.add(cyan);const key=new THREE.SpotLight(0xffffff,110,90,.5,.7,1.4);key.position.set(0,16,-12);key.target.position.set(0,0,-35);scene.add(key,key.target);
      composer=new EffectComposer(renderer);composer.addPass(new RenderPass(scene,camera));bloomPass=new UnrealBloomPass(new THREE.Vector2(innerWidth,innerHeight),.95,.42,.28);composer.addPass(bloomPass);composer.addPass(new OutputPass());
      clock=new THREE.Clock();world=new World();player=new Player();fx=new FXPool();game=new Game();applyToggles();addEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(document.hidden&&PLAY_STATES.has(game.state)&&!game.paused)game.togglePause()});loop();}
    function resize(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,1.65));composer.setSize(innerWidth,innerHeight);}
    function loop(){requestAnimationFrame(loop);const dt=Math.min(.05,clock.getDelta());shaderClock.value+=dt;game.update(dt);bloomPass.strength=game.reduced ? .35 : .95+Math.min(game.combo||0,20)*.004;composer.render();}
    function toggleMute(){game.muted=!game.muted;audio.muted=game.muted;try{localStorage.setItem('rrMuted',game.muted?'1':'0')}catch{}applyToggles();}
    function toggleEffects(){game.reduced=!game.reduced;try{localStorage.setItem('rrReduced',game.reduced?'1':'0')}catch{}applyToggles();}
    function toggleFullscreen(){if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.();}
    function applyToggles(){if(!game)return;$('#mute').textContent='M // SOUND '+(game.muted?'OFF':'ON');$('#mute').classList.toggle('on',!game.muted);$('#effects').textContent='V // '+(game.reduced?'REDUCED FX':'FULL FX');$('#effects').classList.toggle('on',!game.reduced);if(bloomPass)bloomPass.strength=game.reduced ? .35 : .95;$('#grain').style.display=game.reduced?'none':'block';}
    $('#settings').addEventListener('mousedown',e=>e.stopPropagation());$('#mute').addEventListener('click',()=>{audio.ensure();toggleMute()});$('#effects').addEventListener('click',toggleEffects);$('#fullscreen').addEventListener('click',toggleFullscreen);
    try{init()}catch(err){console.error(err);$('#panel').innerHTML='<div class="prompt">WAVE SYSTEM ERROR</div><div class="small">WebGL could not start. Update the browser or enable hardware acceleration.</div>';}
  </script>
</body>
</html>
