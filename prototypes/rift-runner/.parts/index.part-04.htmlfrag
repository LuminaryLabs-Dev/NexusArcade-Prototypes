      update(dt){this.cool=Math.max(0,this.cool-dt);this.dodgeCool=Math.max(0,this.dodgeCool-dt);this.invuln=Math.max(0,this.invuln-dt);if(this.upgradeTime>0){this.upgradeTime-=dt;if(this.upgradeTime<=0)this.upgrade='STANDARD';}
        if(input.edge('dodge')&&this.dodgeCool<=0){this.dodgeT=.34;this.dodgeCool=1.15;this.invuln=.4;this.dodgeDir=new THREE.Vector3(input.moveX||-1,0,input.moveY||0).normalize();audio.dodge();fx.burst(this.group.position.clone().add(new THREE.Vector3(0,1,0)),C.cyan,10,5);}
        const speed=this.dodgeT>0?21:8.2;if(this.dodgeT>0)this.dodgeT-=dt;this.group.position.x+=input.moveX*speed*dt;this.group.position.z+=input.moveY*speed*dt;if(Math.abs(this.group.position.x)>9.35||this.group.position.z>6.2||this.group.position.z<-3||this.group.position.y<-2)this.recover();
        const aim=game.aimTarget;const dir=aim.clone().sub(this.group.position);this.group.rotation.y=lerpAngle(this.group.rotation.y,Math.atan2(-dir.x,-dir.z),.18);
        const run=game.totalTime*10,motion=Math.min(1,Math.hypot(input.moveX,input.moveY)+game.speed/8);this.legs[0].rotation.x=Math.sin(run)*.65*motion;this.legs[1].rotation.x=-this.legs[0].rotation.x;this.body.rotation.z=lerp(this.body.rotation.z,-input.moveX*.09,.15);this.gun.position.z=lerp(this.gun.position.z,this.cool>.02?-.38:-.48,.24);this.group.rotation.z=lerp(this.group.rotation.z,this.dodgeT>0?-input.moveX*.42:0,.2);this.body.material.emissiveIntensity=this.invuln>0&&Math.sin(game.totalTime*35)>0?2.2:.52;this.shield.visible=this.invuln>0;this.shield.rotation.y+=dt*2.4;this.muzzleFlash.visible=this.cool>.02&&this.cool<.11;this.muzzleFlash.scale.setScalar(rand(.7,1.25));for(const t of this.thrusters)t.scale.y=.8+motion*.5+Math.sin(game.totalTime*20)*.08;
        if(game.state===STATE.EXTRACT){this.arms[0].rotation.z=lerp(this.arms[0].rotation.z,-2.3,.12);this.arms[1].rotation.z=lerp(this.arms[1].rotation.z,2.3,.12);this.group.position.y=.12+Math.sin(game.totalTime*6)*.08;}else{this.arms[0].rotation.z=lerp(this.arms[0].rotation.z,0,.12);this.arms[1].rotation.z=lerp(this.arms[1].rotation.z,0,.12);this.group.position.y=lerp(this.group.position.y,0,.2);}
        if(input.fire)this.shoot();if(input.edge('ultimate')&&this.ult>=100)this.useUltimate();}
      shoot(){if(this.cool>0)return;const rates={STANDARD:.16,RAPID:.075,SPREAD:.2,PIERCE:.19,CHAIN:.17};this.cool=rates[this.upgrade]||.16;const muzzle=new THREE.Vector3();this.muzzle.getWorldPosition(muzzle);const base=game.aimTarget.clone().sub(muzzle).normalize(),shots=this.upgrade==='SPREAD'?3:1;for(let i=0;i<shots;i++){const d=base.clone();if(shots>1)d.x+=(i-1)*.075;d.normalize();game.spawnPlayerBullet(muzzle,d,this.upgrade==='PIERCE'?2:0);}game.shots+=shots;audio.shoot();fx.burst(muzzle,C.cyan,game.reduced?1:3,3);}
      useUltimate(){this.ult=0;audio.ultimate();game.flash(C.magenta,.35);game.shake=.8;fx.burst(this.group.position.clone().add(new THREE.Vector3(0,1,0)),C.magenta,50,18);for(const e of [...game.enemies])e.takeDamage(180,true);if(game.boss)game.boss.ultimateHit();game.addScore(500);}
      grant(name){this.upgrade=name;this.upgradeTime=35;game.toast(name+' WEAPON',C.cyan);audio.ui();}
      recover(){this.group.position.set(0,0,2);game.score=Math.max(0,game.score-500);this.damage(12);game.toast('ROUTE RECOVERY // -500',C.orange);}
      damage(n){if(this.invuln>0||game.state===STATE.EXTRACT)return;this.hp=Math.max(0,this.hp-n);this.invuln=.7;game.damageTaken+=n;game.combo=Math.max(0,game.combo-3);game.comboTimer=0;game.shake=.45;game.flash(C.red,.22);audio.hurt();if(this.hp<=0)game.finish(false);}
    }

    function lerpAngle(a,b,t){let d=(b-a+Math.PI)%(Math.PI*2)-Math.PI;return a+d*t}

    class Enemy{
      constructor(type,x,z){this.type=type;this.group=new THREE.Group();this.group.position.set(x,type==='drone'?rand(2.2,4.4):0,z);scene.add(this.group);this.t=rand(0,3);this.attack=rand(.6,1.8);this.dead=false;this.velX=rand(-1,1);this.build();}
      build(){const red=mat(0x330817,C.red,2),orange=mat(0x351507,C.orange,1.8),metal=new THREE.MeshPhysicalMaterial({color:0x151724,metalness:.9,roughness:.18,clearcoat:1,emissive:0x25072d,emissiveIntensity:.45});this.spin=[];
        if(this.type==='drone'){this.hp=42;this.radius=.86;this.body=new THREE.Mesh(new THREE.IcosahedronGeometry(.66,1),red);this.group.add(this.body);for(const s of [-1,1]){const wing=box(.9,.09,.42,metal);wing.position.x=s*.9;this.group.add(wing);const rotor=new THREE.Mesh(new THREE.TorusGeometry(.38,.06,8,24),energyMaterial(C.red,.72));rotor.rotation.x=Math.PI/2;rotor.position.x=s*1.18;this.group.add(rotor);this.spin.push(rotor);}}
        else if(this.type==='rusher'){this.hp=58;this.radius=.82;this.body=box(.9,1.25,.72,orange);this.body.position.y=.94;this.group.add(this.body);for(const s of [-1,1]){const horn=new THREE.Mesh(new THREE.ConeGeometry(.2,.8,8),red);horn.rotation.z=s*.65;horn.position.set(s*.56,1.65,0);this.group.add(horn);const leg=box(.24,.7,.3,metal);leg.position.set(s*.26,.36,0);this.group.add(leg);}}
        else if(this.type==='turret'){this.hp=72;this.radius=.95;const base=cyl(.82,.38,metal);base.position.y=.19;this.group.add(base);this.body=cyl(.62,1.15,metal);this.body.position.y=.78;this.group.add(this.body);const ring=new THREE.Mesh(new THREE.TorusGeometry(.68,.08,8,24),energyMaterial(C.red,.72));ring.rotation.x=Math.PI/2;ring.position.y=.85;this.group.add(ring);this.spin.push(ring);const gun=box(.28,.28,1.5,red);gun.position.set(0,1.28,.42);this.group.add(gun);}
        else{this.hp=145;this.radius=1.32;this.body=box(1.75,2.35,1.2,metal);this.body.position.y=1.25;this.group.add(this.body);const chest=box(1.05,.9,.28,orange);chest.position.set(0,1.55,.72);this.group.add(chest);for(const s of [-1,1]){const shoulder=new THREE.Mesh(new THREE.DodecahedronGeometry(.62,0),metal);shoulder.position.set(s*1.05,1.85,0);this.group.add(shoulder);const fist=box(.55,.75,.65,orange);fist.position.set(s*1.05,.78,.1);this.group.add(fist);}}
        this.maxHp=this.hp;this.weak=new THREE.Mesh(new THREE.SphereGeometry(this.type==='brute'?.36:.23,16,12),energyMaterial(C.orange,.95));this.weak.position.set(0,this.type==='drone'?0:this.type==='brute'?1.55:1.08,.67);this.group.add(this.weak);this.telegraph=new THREE.Mesh(new THREE.RingGeometry(.7,1.05,32),new THREE.MeshBasicMaterial({color:C.orange,transparent:true,opacity:.6,side:THREE.DoubleSide,blending:THREE.AdditiveBlending,depthWrite:false}));this.telegraph.rotation.x=-Math.PI/2;this.telegraph.position.y=.04;this.telegraph.visible=false;this.group.add(this.telegraph);}
      update(dt,speed){if(this.dead)return;this.t+=dt;this.attack-=dt;this.group.position.z+=speed*dt*(this.type==='turret'?.7:1);for(const p of this.spin)p.rotation.z+=dt*5;this.weak.scale.setScalar(.86+Math.sin(this.t*7)*.16);this.telegraph.visible=this.attack<.62;this.telegraph.scale.setScalar(1+Math.max(0,.62-this.attack)*2.5);if(this.type==='drone'){this.group.position.x+=this.velX*dt*2.4;this.group.position.y+=Math.sin(this.t*3)*dt*.5;this.body.rotation.y+=dt*2.2;if(Math.abs(this.group.position.x)>8)this.velX*=-1;}
        if(this.type==='rusher'&&this.attack<.55){this.body.material.emissive.setHex(C.orange);this.body.material.emissiveIntensity=2.5;if(this.attack<0)this.group.position.z+=15*dt;}
        if(this.type==='turret'&&this.attack<.6)this.weak.scale.setScalar(1.5+Math.sin(this.t*20)*.3);
        if(this.attack<=-0.2){this.fire();this.attack=this.type==='rusher'?rand(2.5,3.5):rand(1.8,3.1);this.weak.scale.setScalar(1);}
        if(this.group.position.z>6){player.damage(this.type==='brute'?20:this.type==='rusher'?15:9);this.destroy(false);}}
      fire(){if(this.type==='rusher')return;const origin=this.group.position.clone().add(new THREE.Vector3(0,this.type==='drone'?0:1,0)),target=player.group.position.clone().add(new THREE.Vector3(0,1,0)),d=target.clone().sub(origin).normalize();fx.arc(origin,target,C.red);game.spawnEnemyBullet(origin,d,this.type==='brute'?13:9);}
