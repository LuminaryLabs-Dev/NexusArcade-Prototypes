    let scene,camera,renderer,composer,bloomPass,clock,game,world,player,fx;
    const mat=(color,emissive=color,ei=.2)=>new THREE.MeshStandardMaterial({color,emissive,emissiveIntensity:ei,roughness:.34,metalness:.72});
    const box=(w,h,d,m)=>{const x=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);x.castShadow=x.receiveShadow=true;return x};
    const cyl=(r,h,m)=>{const x=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,12),m);x.castShadow=true;return x};
    const shaderClock={value:0};
    function energyMaterial(color=C.cyan,opacity=1){return new THREE.ShaderMaterial({transparent:opacity<1,depthWrite:opacity>=1,blending:opacity<1?THREE.AdditiveBlending:THREE.NormalBlending,uniforms:{uTime:shaderClock,uColor:{value:new THREE.Color(color)},uOpacity:{value:opacity}},vertexShader:`varying vec2 vUv;varying vec3 vNormalW;varying vec3 vView;void main(){vUv=uv;vec4 w=modelMatrix*vec4(position,1.);vNormalW=normalize(mat3(modelMatrix)*normal);vView=normalize(cameraPosition-w.xyz);gl_Position=projectionMatrix*viewMatrix*w;}`,fragmentShader:`uniform float uTime;uniform vec3 uColor;uniform float uOpacity;varying vec2 vUv;varying vec3 vNormalW;varying vec3 vView;void main(){float scan=.72+.28*sin(vUv.y*90.-uTime*12.);float fres=pow(1.-abs(dot(normalize(vNormalW),normalize(vView))),2.4);float pulse=.72+.28*sin(uTime*5.+vUv.x*18.);vec3 c=uColor*(.45+scan*.35+fres*1.8)*pulse;gl_FragColor=vec4(c,uOpacity*(.38+fres*.62));}`});}
    function floorMaterial(){return new THREE.ShaderMaterial({uniforms:{uTime:shaderClock,uSpeed:{value:0}},vertexShader:`varying vec3 vWorld;void main(){vec4 w=modelMatrix*vec4(position,1.);vWorld=w.xyz;gl_Position=projectionMatrix*viewMatrix*w;}`,fragmentShader:`uniform float uTime;uniform float uSpeed;varying vec3 vWorld;void main(){float gx=step(.94,fract(abs(vWorld.x)*.5));float gz=step(.965,fract((abs(vWorld.z)+uTime*uSpeed*.18)*.18));float lane=1.-smoothstep(.035,.09,abs(fract((vWorld.x+1.5)*.333)-.5));float pulse=.5+.5*sin(uTime*2.4-vWorld.z*.16);vec3 base=mix(vec3(.008,.018,.035),vec3(.015,.045,.07),pulse*.22);vec3 cyan=vec3(.12,.9,1.);vec3 mag=vec3(1.,.035,.62);vec3 c=base+cyan*(gx*.5+gz*.3)+mix(cyan,mag,pulse)*lane*.12;gl_FragColor=vec4(c,1.);}`});}

    class FXPool{
      constructor(){this.items=[];this.rings=[];this.beams=[];const geo=new THREE.TetrahedronGeometry(.1,0);for(let i=0;i<150;i++){const mesh=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:C.cyan,transparent:true,opacity:1,blending:THREE.AdditiveBlending,depthWrite:false}));mesh.visible=false;scene.add(mesh);this.items.push({mesh,life:0,vel:new THREE.Vector3(),spin:new THREE.Vector3(),max:1});}for(let i=0;i<18;i++){const mesh=new THREE.Mesh(new THREE.RingGeometry(.4,.48,32),new THREE.MeshBasicMaterial({color:C.cyan,transparent:true,opacity:0,side:THREE.DoubleSide,blending:THREE.AdditiveBlending,depthWrite:false}));mesh.visible=false;scene.add(mesh);this.rings.push({mesh,life:0,max:1});}for(let i=0;i<24;i++){const geometry=new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(),new THREE.Vector3()]),mesh=new THREE.Line(geometry,new THREE.LineBasicMaterial({color:C.cyan,transparent:true,opacity:0,blending:THREE.AdditiveBlending,depthWrite:false}));mesh.visible=false;scene.add(mesh);this.beams.push({mesh,life:0,max:1});}}
      burst(pos,color=C.cyan,count=8,power=5){if(game.reduced)count=Math.ceil(count*.4);for(let n=0;n<count;n++){const p=this.items.find(i=>i.life<=0);if(!p)break;p.life=p.max=rand(.22,.78);p.mesh.visible=true;p.mesh.position.copy(pos);p.mesh.scale.set(rand(.35,1.4),rand(.35,2.3),rand(.35,1.4));p.mesh.material.color.setHex(color);p.vel.set(rand(-1,1),rand(-.25,1.25),rand(-1,1)).normalize().multiplyScalar(rand(power*.4,power));p.spin.set(rand(-8,8),rand(-8,8),rand(-8,8));}if(count>=10&&!game.reduced){const r=this.rings.find(i=>i.life<=0);if(r){r.life=r.max=.55;r.mesh.visible=true;r.mesh.position.copy(pos);r.mesh.lookAt(camera.position);r.mesh.scale.setScalar(.6);r.mesh.material.color.setHex(color);}}}
      arc(a,b,color=C.cyan){const q=this.beams.find(x=>x.life<=0);if(!q)return;q.life=q.max=.11;q.mesh.visible=true;q.mesh.material.color.setHex(color);const mid=a.clone().lerp(b,.5).add(new THREE.Vector3(rand(-.25,.25),rand(-.25,.25),rand(-.25,.25))),arr=new Float32Array([a.x,a.y,a.z,mid.x,mid.y,mid.z,b.x,b.y,b.z]);q.mesh.geometry.setAttribute('position',new THREE.BufferAttribute(arr,3));q.mesh.geometry.computeBoundingSphere();}
      update(dt){for(const p of this.items)if(p.life>0){p.life-=dt;p.vel.y-=5*dt;p.mesh.position.addScaledVector(p.vel,dt);p.mesh.rotation.x+=p.spin.x*dt;p.mesh.rotation.y+=p.spin.y*dt;p.mesh.rotation.z+=p.spin.z*dt;p.mesh.scale.multiplyScalar(.965);p.mesh.material.opacity=clamp(p.life/p.max,0,1);if(p.life<=0)p.mesh.visible=false;}for(const r of this.rings)if(r.life>0){r.life-=dt;r.mesh.scale.multiplyScalar(1+dt*7);r.mesh.material.opacity=clamp(r.life/r.max,0,1)*.65;if(r.life<=0)r.mesh.visible=false;}for(const b of this.beams)if(b.life>0){b.life-=dt;b.mesh.material.opacity=clamp(b.life/b.max,0,1);if(b.life<=0)b.mesh.visible=false;}}
    }

    class World{
      constructor(){this.group=new THREE.Group();scene.add(this.group);this.segments=[];this.hazards=[];this.barrels=[];this.gates=[];this.archives=[];this.floorMat=floorMaterial();this.build();}
      build(){const edgeMat=mat(0x071d2b,C.cyan,1.8),wallMat=mat(0x090b16,0x160b2a,.45),trimMat=mat(0x171a24,C.magenta,.8);
        for(let i=0;i<16;i++){const g=new THREE.Group(),floor=box(20,.62,12,this.floorMat);floor.position.y=-.42;g.add(floor);for(const side of [-1,1]){const rail=box(.28,.42,12,edgeMat);rail.position.set(side*9.72,.12,0);g.add(rail);for(let p=-5;p<=5;p+=5){const pillar=box(.72,4.8,.85,wallMat);pillar.position.set(side*10.15,2,p);g.add(pillar);const lamp=box(.78,.12,.92,side>0?edgeMat:trimMat);lamp.position.set(side*9.76,3.65,p);g.add(lamp);}const facade=box(rand(3,6),rand(5,12),8,wallMat);facade.position.set(side*rand(13,18),facade.geometry.parameters.height/2-1,rand(-1,1));g.add(facade);}
          for(let k=0;k<5;k++){const stripe=box(.09,.035,2.5,k%2?edgeMat:trimMat);stripe.position.set((k-2)*3,-.075,0);g.add(stripe);}if(i%3===0){const arch=new THREE.Group();for(const s of [-1,1]){const leg=box(.45,7,.5,wallMat);leg.position.set(s*9.2,3.4,0);arch.add(leg);}const top=box(18.8,.45,.5,edgeMat);top.position.y=6.8;arch.add(top);g.add(arch);}g.position.z=-